APP_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
OCR_LANGUAGE=ch
OCR_DEVICE=cpu
PARSE_CHUNK_SIZE=1200
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=4096
LLM_PARALLEL_WORKERS=4
LLM_BATCH_CHUNK_LIMIT=8
LLM_BATCH_CHAR_LIMIT=8000
LLM_KNOWLEDGE_TIMEOUT_SECONDS=45
LLM_KNOWLEDGE_MAX_TOKENS=1024
LLM_KNOWLEDGE_BATCH_CHUNK_LIMIT=12
LLM_KNOWLEDGE_BATCH_CHAR_LIMIT=12000
LLM_KNOWLEDGE_FAST_PATH=true
LLM_KNOWLEDGE_FAST_PATH_MAX_CHARS=1800
LLM_TRUST_ENV_PROXY=false
GEOCODING_ENABLED=true
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=GeoText-Spatialization/0.6
GEOCODING_TIMEOUT_SECONDS=20
GEOCODING_MIN_INTERVAL_SECONDS=1
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=geotext_chunks
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
